# ============================================================
# Variables de entorno del agente WhatsApp
# Copia este archivo a .env.local y rellena los valores.
# El comando /setup lo hace automáticamente.
# ============================================================

# --- SUPABASE ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- REDIS ---
REDIS_URL=redis://localhost:6379

# --- OBLIGATORIO ---

# API key de OpenRouter (https://openrouter.ai)
# El agente usa OpenRouter para hablar con el modelo de IA que elijas.
# Plan gratuito + 5€ de saldo dan para meses de uso normal.
OPENROUTER_API_KEY=sk-or-v1-tu-api-key-aqui

# Modelo de IA que usará el agente.
# Recomendado: openai/gpt-4o-mini (barato, rápido, suficiente)
# Otros buenos: anthropic/claude-haiku-4-5, google/gemini-2.5-flash
# Los modelos terminados en :free están saturados — NO usar en producción.
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- OPCIONAL · Tools ---
# Estas variables solo hacen falta si activas las tools correspondientes.
# El agente funciona sin ellas — las tools quedan inactivas hasta configurarlas.

# Webhook de Google Sheets (Apps Script) para guardar leads
# Guía paso a paso en docs/04-configurar-tools.md
GOOGLE_SHEETS_WEBHOOK_URL=

# URL de tu calendario en Cal.com (o Calendly) para agendar llamadas
# Ejemplo: https://cal.com/tu-usuario/diagnostico
CAL_BOOKING_URL=

# --- OPCIONAL · Producción ---

# Puerto del dashboard Next.js (por defecto 3000)
PORT=3000

# Nivel de log del bot: silent | error | warn | info | debug
LOG_LEVEL=info

# --- OPCIONAL · Seguridad ---
# Dashboard authentication (basic auth)
# Si no se establecen, la autenticación está deshabilitada (modo desarrollo)
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- OPCIONAL · Rate Limiting ---
# LLM rate limiting per conversation
# LLM_RATE_LIMIT_MAX_REQUESTS=10
# LLM_RATE_LIMIT_WINDOW_MS=60000
